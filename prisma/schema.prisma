generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  articles           Article[]
  additionalArticles Article[] @relation("ArticleAdditionalCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id         String   @id @default(cuid())
  title      String
  slug       String?  @unique
  categoryId           String
  category             Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  additionalCategories Category[] @relation("ArticleAdditionalCategories")
  state      String
  district   String
  reporter   String   // Backward compatible raw name string
  reporterId String?  // Optional relation to verified Reporter model
  reporterRel Reporter? @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  status     String   @default("Draft") // Draft, Pending, Published
  content    String
  imageUrl   String?
  views      Int      @default(0)
  editCount  Int      @default(0) // Track number of edits on published articles (max 3)
  
  // SEO fields
  seoTitle   String?
  seoDesc    String?
  seoKeys    String?
  
  // Citizen Journalism fields
  contributorId String?
  contributor   Contributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Reporter {
  id            String    @id @default(cuid())
  reporterCode  String?   @unique
  email         String    @unique
  password      String
  fullName      String
  fatherHusbandName String?
  mobile        String
  bloodGroup    String?
  state         String
  district      String
  poPs          String
  block         String
  fullAddress   String
  aadhaarNumber String?
  aadhaarUrl    String?
  aadhaarBackUrl String?
  panUrl        String?
  voterIdUrl    String?
  photoUrl      String?
  educationUrl  String?
  videoUrl      String?
  status        String    @default("Pending") // Pending, Approved, Rejected
  joiningLetter String?   // PDF Joining Letter URL
  rejectionReason String?
  articles      Article[]
  messages      ReporterMessage[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  banners   Banner[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  category    AdCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  type        String   // "desktop" or "mobile"
  position    Int      // 1‑4
  imageUrl    String
  linkUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, type, position])
}

model Epaper {
  id          String   @id @default(cuid())
  title       String?
  date        DateTime @unique
  pdfUrl      String?
  thumbnailUrl String?
  pages       String? // JSON string of page image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contributor {
  id            String    @id @default(cuid())
  contributorId String?   @unique // Format: TDA/NEWS/IN/JH/PKR/HP/001
  fullName      String
  mobile        String    @unique
  password      String
  selfieUrl     String?   // Optional profile photo
  state         String
  district      String
  block         String?
  area          String?
  fullAddress   String?   // Make optional, we rely more on block/area now
  locationLat   Float?
  locationLng   Float?
  status        String    @default("Active") // Active, Suspended, Rejected
  points        Int       @default(0)
  trustScore    Int       @default(50) // 0-100 score for spam detection and reliability
  rank          String    @default("Beginner")
  articles      Article[]
  submissions   Submission[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Submission {
  id            String    @id @default(cuid())
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  contributorId String
  title         String
  description   String
  category      String
  address       String?
  lat           Float?
  lng           Float?
  mediaUrls     String?   // JSON string array of images/videos
  status        String    @default("Pending") // Pending, Approved (Published), Rejected, GroundAlert
  isGroundAlert Boolean   @default(false)
  adminNotes    String?
  articleId     String?   // If converted to Article
  messages      SubmissionMessage[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SubmissionMessage {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sender       String     // "Admin" or "Contributor"
  message      String
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model PageContent {
  id        String   @id @default(cuid())
  pageSlug  String   @unique
  content   String
  seoTitle  String?
  seoDesc   String?
  seoKeys   String?
  seoImage  String?
  updatedAt DateTime @updatedAt
}

model AdClient {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  ads       ClientAd[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ClientAd {
  id            String    @id @default(cuid())
  client        AdClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  title         String
  categoryName  String    // e.g. "Home", "Global", "LiveTV"
  position      Int       // 1-4
  desktopImgUrl String?   // Base64 desktop image
  mobileImgUrl  String?   // Base64 mobile image
  linkUrl       String?   // Target redirect website
  isActive      Boolean   @default(true)
  startDate     DateTime? // Campaign schedule start
  endDate       DateTime? // Campaign schedule end
  impressions   Int       @default(0)
  clicks        Int       @default(0)
  
  // Geotargeting Fields
  targetType      String    @default("All") // "All", "State", "District", "Radius"
  targetStates    String?   // JSON stringified array e.g. '["Jharkhand", "Delhi"]'
  targetDistricts String?   // JSON stringified array e.g. '["Ranchi", "Patna"]'
  targetLat       Float?    // Center Latitude for geofence
  targetLng       Float?    // Center Longitude for geofence
  targetRadius    Float?    // Geofence Radius in kilometers
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReporterMessage {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Reporter @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  sender     String   // "Admin" or "Reporter"
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Affiliate {
  id            String    @id @default(cuid())
  affiliateCode String    @unique // e.g. TDA1001
  email         String    @unique
  password      String
  fullName      String
  mobile        String
  dob           String
  address       String
  city          String
  state         String
  pinCode       String
  aadhaarNumber String?
  panNumber     String?
  bankHolderName String?
  bankAccountNumber String?
  ifscCode      String?
  upiId         String?
  photoUrl      String?
  status        String    @default("Pending") // Pending, Approved, Rejected, Suspended
  kycVerified   Boolean   @default(false)
  termsAccepted Boolean   @default(false)
  clicks        ReferralClick[]
  leads         ReferralLead[]
  sales         ReferralSale[]
  transactions  WalletTransaction[]
  payouts       Payout[]
  agreements    AffiliateAgreement[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReferralClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  referrer    String?   // e.g. WhatsApp, Facebook, Direct
  targetUrl   String?
  createdAt   DateTime  @default(now())
}

model ReferralLead {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String
  serviceName   String?
  status        String    @default("Pending") // Pending, Converted, Rejected
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReferralSale {
  id               String              @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  customerName     String
  customerEmail    String
  customerPhone    String
  packageName      String
  baseValue        Float
  gstAmount        Float
  totalPaid        Float
  paymentStatus    String              @default("Paid") // Paid, Refunded
  transactionId    String?
  referralSource   String?             // WhatsApp, Facebook, Direct, etc.
  commissionRate   Float               @default(0.15)
  commissionEarned Float
  commissionStatus String              @default("Pending") // Pending, Approved, Paid, Reversed
  transactions     WalletTransaction[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id          String        @id @default(cuid())
  affiliateId String
  affiliate   Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  type        String        // Credit, Debit, Reversal
  status      String        @default("Pending") // Pending, Approved, Paid, Cancelled
  description String?
  saleId      String?
  sale        ReferralSale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payoutId    String?
  payout      Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

model Payout {
  id              String              @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount          Float
  payoutDate      DateTime            @default(now())
  referenceNumber String?
  paymentMethod   String              // Bank Transfer, UPI, NEFT, IMPS
  status          String              @default("Pending") // Pending, Processing, Paid, Failed
  transactions    WalletTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model MarketingMaterial {
  id           String   @id @default(cuid())
  title        String
  type         String   // Poster, Banner, Video, PDF, Guide
  fileUrl      String
  thumbnailUrl String?
  description  String?
  createdAt    DateTime @default(now())
}

model AffiliateAgreement {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime  @default(now())
}
